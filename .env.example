###############################################################################
# Company Brain – Environment Variables
# Copy this file to .env and fill in real values. NEVER commit .env to git.
###############################################################################

# ── Production security (REQUIRED — the app fails closed without these) ───────
# When ENVIRONMENT=production, the backend refuses to boot if SKILL_SIGNING_KEY
# or AUDIT_HMAC_SECRET are unset/placeholder/too short, ignores AUTH_BYPASS_DEV,
# rejects tenantless tokens, and fails the quarantine veto closed.
ENVIRONMENT=production                 # local | production  (drives all fail-closed guards)
SKILL_SIGNING_KEY=                     # 32+ char random secret (OAuth state signing)
AUDIT_HMAC_SECRET=                     # 32+ char random secret (tamper-evident audit chain)
AUTH_BYPASS_DEV=                       # MUST be unset/false in production (dev-only auth bypass)
TRUSTED_PROXY_COUNT=0                  # # of trusted proxies in front (e.g. 1 behind one ALB/Vercel).
                                       # 0 = use the direct TCP peer; only then is X-Forwarded-For honored.

# ── General ──────────────────────────────────────────────────────────────────
NODE_ENV=production
API_TOKEN=                            # Shared API token for service-to-service auth

# ── Frontend (Next.js) ──────────────────────────────────────────────────────
FRONTEND_PORT=3000
FRONTEND_ORIGIN=http://localhost:3000  # exact origin allowed by CORS (set to the real https origin in prod)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Backend (FastAPI) ───────────────────────────────────────────────────────
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000      # public base URL; used to build OAuth redirect_uri

# ── OIDC authentication (REQUIRED in prod — these are what the backend reads) ─
# Without OIDC_ISSUER configured, all authenticated requests are rejected.
OIDC_ISSUER=                           # e.g. https://your-org.okta.com/oauth2/default
OIDC_AUDIENCE=                         # expected JWT `aud` claim
OKTA_DOMAIN=https://your-org.okta.com  # (optional, for the Okta-hosted login UI)
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=

# ── LLM / AI ────────────────────────────────────────────────────────────────
LLM_PROVIDER=openai                   # openai | azure | anthropic | gemini
LLM_API_KEY=
LLM_MODEL=                            # provider-specific model id (optional)

# ── Weaviate (Vector DB) ────────────────────────────────────────────────────
WEAVIATE_URL=http://localhost:8080
WEAVIATE_PORT=8080
WEAVIATE_API_KEY=change-me
WEAVIATE_API_USER=admin@companybrain.io

# ── Neo4j (Knowledge Graph) ─────────────────────────────────────────────────
NEO4J_AUTH=neo4j/change-me-now        # format: user/password
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-now
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ── Redis / Celery (Message bus + workers) ──────────────────────────────────
REDIS_PASSWORD=change-me-redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://localhost:6379/0

# ── Kafka / ZooKeeper: REMOVED ───────────────────────────────────────────────
# Kafka and ZooKeeper were removed from the stack — no code produces to or
# consumes from Kafka. The async task path is Celery + Redis. No env vars needed.

# ── HashiCorp Vault (optional; use platform secrets in the managed stack) ─────
VAULT_TOKEN=dev-only-token            # Replace in production!
VAULT_PORT=8200

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_DB=companybrain
POSTGRES_USER=cb_admin
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_PORT=5432

# ── OAuth app credentials (for the /oauth/connect integration flow) ──────────
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Executor providers — keys here unblock the governed action executors:
GOOGLE_CLIENT_ID=                      # Google Calendar (calendar_create_event)
GOOGLE_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=                     # HubSpot CRM (crm_upsert_contact)
HUBSPOT_CLIENT_SECRET=
QUICKBOOKS_CLIENT_ID=                  # QuickBooks Online (accounting_*)
QUICKBOOKS_CLIENT_SECRET=

# ── Inbound webhook verification (HMAC — required for those routes) ──────────
SLACK_SIGNING_SECRET=                  # verifies Slack Event API webhooks
GITHUB_WEBHOOK_SECRET=                 # verifies GitHub webhooks

# ── Direct connector tokens (non-OAuth ingestion) ───────────────────────────
SLACK_BOT_TOKEN=xoxb-your-token
NOTION_API_KEY=ntn_your-key
GITHUB_TOKEN=ghp_your-token

# ── Per-tenant LLM budget (cost control) ─────────────────────────────────────
# Default monthly USD cap applied when a tenant has no explicit
# settings["llm_monthly_budget_usd"]. 0 = unlimited (no enforcement).
DEFAULT_LLM_MONTHLY_BUDGET_USD=0

# ── Quarantine lock (safety) ─────────────────────────────────────────────────
# Safety locks REQUIRE Postgres. For local dev WITHOUT asyncpg/Postgres you may
# set this true to allow a Redis-only lock — NEVER set true in production
# (ignored when ENVIRONMENT=production).
QUARANTINE_LOCK_ALLOW_REDIS_ONLY_DEV=false

# ── Error tracking (optional) ────────────────────────────────────────────────
# Set a DSN to enable Sentry (requires `pip install sentry-sdk`). Empty = off.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
ENVIRONMENT=local                       # local | production — gates fail-closed behavior

# ── Database connection pool (right-size for your managed Postgres) ───────────
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
