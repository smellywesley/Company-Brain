###############################################################################
# Company Brain – Environment Variables
# Copy this file to .env and fill in real values. NEVER commit .env to git.
###############################################################################

# ── General ──────────────────────────────────────────────────────────────────
NODE_ENV=production
API_TOKEN=                            # Shared API token for service-to-service auth

# ── Frontend (Next.js) ──────────────────────────────────────────────────────
FRONTEND_PORT=3000
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Backend (FastAPI) ───────────────────────────────────────────────────────
BACKEND_PORT=8000

# ── Okta / OIDC ─────────────────────────────────────────────────────────────
OKTA_DOMAIN=https://your-org.okta.com
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=

# ── LLM / AI ────────────────────────────────────────────────────────────────
LLM_PROVIDER=openai                   # openai | azure | anthropic | gemini
LLM_API_KEY=

# ── Weaviate (Vector DB) ────────────────────────────────────────────────────
WEAVIATE_URL=http://localhost:8080
WEAVIATE_PORT=8080
WEAVIATE_API_KEY=change-me
WEAVIATE_API_USER=admin@companybrain.io

# ── Neo4j (Knowledge Graph) ─────────────────────────────────────────────────
NEO4J_AUTH=neo4j/change-me-now        # format: user/password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ── Kafka / ZooKeeper (Message Bus) ─────────────────────────────────────────
KAFKA_BROKER=kafka:9092
KAFKA_EXTERNAL_PORT=9093
KAFKA_EXTERNAL_HOST=localhost
KAFKA_ADMIN_USER=admin
KAFKA_ADMIN_PASSWORD=admin-secret
KAFKA_PRODUCER_PASSWORD=producer-secret
KAFKA_CONSUMER_PASSWORD=consumer-secret

# ── HashiCorp Vault ─────────────────────────────────────────────────────────
VAULT_TOKEN=dev-only-token            # Replace in production!
VAULT_PORT=8200

# ── External Integrations ───────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-token
NOTION_API_KEY=ntn_your-key
GITHUB_TOKEN=ghp_your-token

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_DB=companybrain
POSTGRES_USER=cb_admin
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_PORT=5432

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change-me-redis
REDIS_PORT=6379

# ── Security ────────────────────────────────────────────────────────────────
SKILL_SIGNING_KEY=change-me-signing-key-minimum-32-chars
